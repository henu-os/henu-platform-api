# ==============================================================================
# HENU PLATFORM API — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Safe template for version control. NEVER commit production secrets or .env.
# ==============================================================================

# Node Runtime & API Routing
NODE_ENV=production
API_PREFIX=api/v1
API_BASE_URL=https://henu-platform-api.onrender.com

# PostgreSQL Database (Neon Connection String)
# Runtime pooled string: postgresql://<USER>:<PASSWORD>@<HOST>-pooler.<REGION>.aws.neon.tech/<DB>?sslmode=require
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/henu_platform?sslmode=require"

# Authentication & Cryptographic Tokens
# JWT_SECRET: Cryptographically secure random secret string (min 64 chars)
JWT_SECRET=REPLACE_WITH_NEW_SECURE_RANDOM_SECRET_MINIMUM_64_CHARACTERS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# GitHub App Integration
GITHUB_APP_ID=5844474
GITHUB_APP_CLIENT_ID=Iv23li0tyIdP5sTnwoLw
# Base64-encoded RSA .pem private key generated for GitHub App
GITHUB_APP_PRIVATE_KEY_BASE64=REPLACE_WITH_BASE64_PRIVATE_KEY
# Webhook secret configured in GitHub App settings
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_NEW_WEBHOOK_SECRET

# CORS Allowed Origins (Comma-separated, no wildcards)
ADMIN_CORS_ORIGIN="https://henu-admin.netlify.app,http://localhost:3001"
HUB_CORS_ORIGIN="https://henu-hub.netlify.app,tauri://localhost,http://tauri.localhost,http://localhost:1420"

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120
