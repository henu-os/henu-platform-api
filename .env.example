# ==============================================================================
# HENU PLATFORM API - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' and populate with deployment-specific credentials.
# NEVER commit the active '.env' file or private keys to source control.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
API_BASE_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=<SCHEMA>&sslmode=<SSL_MODE>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/henu_platform?schema=public"

# Authentication & Cryptographic Keys
# JWT_SECRET: Cryptographically secure random secret (min 64 chars in production)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MINIMUM_64_CHARACTERS_ENTROPY_KEY_REQUIRED
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
# GITHUB_APP_PRIVATE_KEY_BASE64: Base64-encoded RSA .pem private key
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# CORS Configuration
# Comma-separated list of allowed origins or regex patterns. Wildcard '*' is disallowed in production.
ADMIN_CORS_ORIGIN="http://localhost:5173,http://localhost:3001"
HUB_CORS_ORIGIN="http://localhost:8080,tauri://localhost,http://tauri.localhost"

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120
